{
  "manifest_version": 3,
  "name": "Tooltrace - Manage Your Accounts and Subscriptions",
  "version": "1.0.0",
  "description": "Auto-detect SaaS tools you're using and add them to your Tooltrace Hub",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webNavigation",
    "cookies",
    "contextMenus"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tooltrace Hub",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}