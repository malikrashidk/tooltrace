# Application
NODE_ENV=production
PORT=5000
APP_URL=https://app.tooltrace.io

# Database
DATABASE_URL=postgres://postgres:postgres@postgres:5432/saas_tools_hub

# JWT
JWT_SECRET=your-secret-key-change-in-production-min-32-chars

# Paddle (Payments)
PADDLE_API_KEY=your_paddle_api_key
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret
# Client-side (Public)
VITE_PADDLE_CLIENT_TOKEN=live_...
VITE_PADDLE_PRICE_ID_PRO=pri_...
VITE_PADDLE_PRICE_ID_ENTERPRISE=pri_...

# Cloudflare R2 (Receipt Storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=tooltrace-receipts

# Google OAuth (Login & Inbox Discovery)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH_CALLBACK_URL=https://app.tooltrace.io

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Admin Initialization
ADMIN_EMAIL=admin@tooltrace.io
ADMIN_PASSWORD=secure_password_here
