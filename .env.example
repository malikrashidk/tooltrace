# Application
NODE_ENV=production
PORT=5000
APP_URL=https://app.tooltrace.io

# Database
DATABASE_URL=postgres://postgres:postgres@postgres:5432/saas_tools_hub

# JWT
# CRITICAL: Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-change-in-production-min-32-chars

# Polar.sh Payments (https://polar.sh)
POLAR_API_KEY=your_polar_api_key
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret
POLAR_PRICE_ID_PRO_MONTHLY=your_pro_monthly_price_id
POLAR_PRICE_ID_PRO_YEARLY=your_pro_yearly_price_id
POLAR_PRICE_ID_ENTERPRISE_MONTHLY=your_enterprise_monthly_price_id
POLAR_PRICE_ID_ENTERPRISE_YEARLY=your_enterprise_yearly_price_id

# Cloudflare R2 (Optional - File Storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=tooltrace-receipts

# Google OAuth (Login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=https://app.tooltrace.io/api/auth/google/callback
OAUTH_CALLBACK_URL=https://app.tooltrace.io

# Facebook OAuth (Optional)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
MAIL_FROM=noreply@app.tooltrace.io

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Admin Initialization
ADMIN_EMAIL=admin@tooltrace.io
ADMIN_PASSWORD=secure_password_here
